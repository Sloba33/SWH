# ============================================================================
#  Unity .gitattributes  —  line-ending normalization, YAML merge, Git LFS
# ============================================================================
#
#  LFS note: patterns below take effect for files committed AFTER this file is
#  in place (or whenever a matching file is next modified). Existing binaries
#  already in history stay as normal blobs until a coordinated full-history
#  `git lfs migrate import` is run across all branches.
# ============================================================================

# Auto detect text files and perform LF normalization on commit.
* text=auto

# ----------------------------------------------------------------------------
#  Unity YAML — keep as text, use UnitySmartMerge (UnityYAMLMerge) when set up.
#  To enable the merge tool, run:
#    git config merge.unityyamlmerge.name "Unity SmartMerge"
#    git config merge.unityyamlmerge.driver '"<UnityHub>/<ver>/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %B %A %A'
# ----------------------------------------------------------------------------
*.cs            text diff=csharp
*.shader        text
*.cginc         text
*.hlsl          text
*.compute       text

*.meta          -text merge=unityyamlmerge
*.unity         -text merge=unityyamlmerge
*.asset         -text merge=unityyamlmerge
*.prefab        -text merge=unityyamlmerge
*.mat           -text merge=unityyamlmerge
*.anim          -text merge=unityyamlmerge
*.controller    -text merge=unityyamlmerge
*.overrideController -text merge=unityyamlmerge
*.physicMaterial -text merge=unityyamlmerge
*.physicsMaterial2D -text merge=unityyamlmerge
*.playable      -text merge=unityyamlmerge
*.mask          -text merge=unityyamlmerge
*.brush         -text merge=unityyamlmerge
*.flare         -text merge=unityyamlmerge
*.fontsettings  -text merge=unityyamlmerge
*.guiskin       -text merge=unityyamlmerge
*.giparams      -text merge=unityyamlmerge
*.renderTexture -text merge=unityyamlmerge
*.spriteatlas   -text merge=unityyamlmerge
*.terrainlayer  -text merge=unityyamlmerge
*.mixer         -text merge=unityyamlmerge
*.signal        -text merge=unityyamlmerge

# ============================================================================
#  Git LFS  —  binary assets
# ============================================================================

